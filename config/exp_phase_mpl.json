{
  "data": "./raw_data/processed_data",
  "bundle_json": "./raw_data/processed_data/norm_template.json",
  "out": "./models/exp_phase_e2e_sc",
  "run_name": "exp_phase_MLP",
  "epochs": 18,
  "batch": 16,
  "lr": 0.001,
  "seq_len": 60,
  "amp": true,
  "tf_mode": "epoch_linear",
  "tf_start_epoch": 5,
  "tf_end_epoch": 8,
  "tf_max": 1.0,
  "tf_min": 0.5,
  "ss_chunk_len": 1,
  "encoder_path": "./models/motion_encoder_equiv.pt",
  "foot_contact_threshold": 2.0,
  "diag_input_stats": true,
  "freerun_debug_path": "debug_output/freerun_diag_ep002.pt",
  "freerun_horizon": 0,
  "freerun_weight": 0.0,
  "freerun_grad_log": false,
  "monitor_batches": 2,
  "eval_horizon": 14,
  "eval_warmup": 0,
  "width": 512,
  "freerun_debug_steps": 14,
  "yaw_forward_offset": 0,
  "history_debug_steps": 0,
  "history_use_trend_features": true,
  "teacher_rot_noise_deg": 0.0,
  "teacher_rot_noise_prob": 0.0,
  "input_step_noise_prob": 0.0,
  "input_noise_deg_mix": [],
  "w_rot_local": 0.2,
  "w_root_vel": 0.05,
  "w_root_speed": 0.03,
  "contact_plan_enable": true,
  "contact_plan_hidden": 64,
  "contact_plan_dropout": 0.0,
  "contact_plan_inject": "plan_z",
  "contact_plan_inject_detach": true,
  "w_contact_plan": 1.0,
  "contact_meas_enable": true,
  "contact_meas_hidden": 64,
  "contact_meas_dropout": 0.0,
  "w_contact_meas": 0.05,
  "meas_pose_hist_drop_prob": 0.0,
  "meas_pose_hist_delay_prob": 0.0,
  "meas_pose_hist_noise_std": 0.0,
  "freerun_stage_schedule": [
    {
      "range": [1, 4],
      "label": "stage1_warmup_tf1",
      "trainer": {
        "freerun_weight": 0.0,
        "freerun_horizon": 0
      },
      "params": {
        "tf_max": 1.0,
        "tf_min": 1.0,
        "ss_chunk_len": 1,
        "opt_lr": 0.001
      }
    },
    {
      "range": [5, 8],
      "label": "stage2_transition_tf1_to_p05",
      "trainer": {
        "freerun_weight": 0.0,
        "freerun_horizon": 0
      },
      "params": {
        "tf_max": 1.0,
        "tf_min": 0.5,
        "ss_chunk_len": 1,
        "opt_lr": 0.0005
      }
    },
    {
      "range": [9, 18],
      "label": "stage3_p05",
      "trainer": {
        "freerun_weight": 0.0,
        "freerun_horizon": 0
      },
      "params": {
        "tf_max": 0.5,
        "tf_min": 0.5,
        "ss_chunk_len": 1,
        "opt_lr": 0.0002
      }
    }
  ]
}
